# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=vehicle_db

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=changeme

# ─── Mail (dev: mailhog, prod: your SMTP relay) ──────────────────────────────
MAIL_HOST=mailhog
MAIL_PORT=1025

# ─── JWT — generate a secure random secret ───────────────────────────────────
# openssl rand -hex 32
JWT_SECRET=
